<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="false"><shape>
        <stroke android:width="2dp" android:color="#30808080" /><solid android:color="@android:color/transparent" />
        <corners android:radius="16dp" /><size android:width="16dp" android:height="16dp" />
    </shape></item>
    <item android:state_checked="true"><shape>
        <solid android:color="@color/dialog_selected" /><corners android:radius="16dp" /><size android:width="16dp" android:height="16dp" />
    </shape></item>
</selector>
