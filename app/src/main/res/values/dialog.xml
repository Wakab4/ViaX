<resources>
    <color name="dialog_panel">#FFFFFF</color>
    <color name="dialog_selected">#6F8DE1</color>
    <dimen name="dialog_body_size">14sp</dimen>
    <style name="Theme.PureBrowser.Dialog" parent="android:style/Theme.Holo.Dialog.NoActionBar">
        <item name="android:backgroundDimAmount">0.4</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowBackground">@drawable/browser_dialog_background</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@style/Animation.PureBrowser.Dialog</item>
    </style>
    <style name="Widget.PureBrowser.DialogButton" parent="">
        <item name="android:textSize">14sp</item><item name="android:textColor">#6F8DE1</item>
        <item name="android:gravity">center</item><item name="android:padding">16dp</item>
        <item name="android:minWidth">56dp</item><item name="android:lines">1</item><item name="android:ellipsize">end</item>
        <item name="android:background">@drawable/dialog_button_feedback</item>
    </style>
    <style name="Animation.PureBrowser.Dialog" parent="android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/browser_dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/browser_dialog_exit</item>
    </style>
</resources>
