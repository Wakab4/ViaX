<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/element_picker_selector" android:layout_width="match_parent" android:layout_height="match_parent"
        android:textSize="12sp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="4dp" android:paddingBottom="4dp"
        android:hint="请点击广告区域来标记" android:ellipsize="end" android:lines="1" android:maxLines="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
        <ImageView android:id="@+id/element_picker_move" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="12dp"
            android:src="@drawable/ref_ic_marker_move" android:background="@drawable/dialog_button_feedback" android:contentDescription="Move view" />
        <TextView android:id="@+id/element_picker_parent" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:background="@drawable/dialog_button_feedback" android:text="扩大" />
        <TextView android:id="@+id/element_picker_child" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:background="@drawable/dialog_button_feedback" android:text="缩小" />
        <TextView android:id="@+id/element_picker_save" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:background="@drawable/dialog_button_feedback" android:text="保存" />
        <TextView android:id="@+id/element_picker_cancel" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:background="@drawable/dialog_button_feedback" android:text="@android:string/cancel" />
    </LinearLayout>
</LinearLayout>
