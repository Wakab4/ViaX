<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <EditText
        android:id="@+id/ref_translation_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@+id/ref_translation_clear"
        android:textSize="14sp"
        android:gravity="top"
        android:background="@android:color/transparent"
        android:padding="12dp"
        android:hint="文字"
        android:inputType="textNoSuggestions" />
    <ImageView
        android:id="@+id/ref_translation_clear"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignTop="@id/ref_translation_input"
        android:layout_alignParentEnd="true"
        android:padding="12dp"
        android:background="@drawable/ref_translation_feedback"
        android:src="@drawable/ref_translation_exit"
        android:contentDescription="退出" />
    <View
        android:id="@+id/ref_translation_divider"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_below="@id/ref_translation_input" />
    <ProgressBar
        android:id="@+id/ref_translation_progress"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_below="@id/ref_translation_input"
        android:background="@android:color/transparent"
        android:max="100"
        android:progress="50"
        android:indeterminate="false"
        android:indeterminateOnly="false" />
    <TextView
        android:id="@+id/ref_translation_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/ref_translation_input"
        android:layout_toStartOf="@+id/ref_translation_copy"
        android:textSize="14sp"
        android:gravity="top"
        android:padding="12dp"
        android:textIsSelectable="true" />
    <ImageView
        android:id="@+id/ref_translation_copy"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignTop="@id/ref_translation_result"
        android:layout_alignParentEnd="true"
        android:padding="12dp"
        android:background="@drawable/ref_translation_feedback"
        android:src="@drawable/ref_translation_copy"
        android:contentDescription="复制文本" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_below="@id/ref_translation_result"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/ref_translation_source"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:textSize="12sp"
            android:gravity="center" />
        <ImageView
            android:id="@+id/ref_translation_swap"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:padding="14dp"
            android:background="@drawable/ref_translation_feedback"
            android:src="@drawable/ref_translation_swap"
            android:contentDescription="交换语言" />
        <TextView
            android:id="@+id/ref_translation_target"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:textSize="12sp"
            android:gravity="center" />
        <ImageView
            android:id="@+id/ref_translation_submit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:layout_margin="4dp"
            android:padding="9dp"
            android:src="@drawable/ref_translation_submit"
            android:tint="@android:color/white"
            android:contentDescription="翻译" />
    </LinearLayout>
</RelativeLayout>
