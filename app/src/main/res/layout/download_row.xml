<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="8dp" android:paddingBottom="8dp">
    <ImageView android:id="@+id/download_icon" android:layout_width="24dp" android:layout_height="24dp"
        android:layout_marginStart="4dp" android:layout_marginEnd="8dp" android:layout_centerVertical="true"
        android:importantForAccessibility="no" />
    <TextView android:id="@+id/download_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_toEndOf="@id/download_icon" android:layout_toStartOf="@+id/download_action"
        android:layout_alignWithParentIfMissing="true" android:layout_marginStart="4dp" android:layout_marginEnd="4dp"
        android:layout_marginTop="4dp" android:layout_marginBottom="2dp" android:textSize="14sp"
        android:singleLine="true" android:ellipsize="middle" android:textDirection="locale" />
    <ProgressBar android:id="@+id/download_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="2dp" android:max="1000" android:indeterminate="false"
        android:layout_below="@id/download_name" android:layout_alignStart="@id/download_name" android:layout_alignEnd="@id/download_name" />
    <TextView android:id="@+id/download_detail" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_below="@id/download_progress" android:layout_alignStart="@id/download_name" android:layout_alignEnd="@id/download_name"
        android:layout_alignWithParentIfMissing="true" android:layout_marginTop="2dp" android:layout_marginBottom="4dp"
        android:textSize="11sp" android:maxLines="3" android:ellipsize="end" android:textDirection="locale" />
    <ImageView android:id="@id/download_action" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp"
        android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_toStartOf="@+id/download_checked"
        android:layout_centerVertical="true" android:layout_alignWithParentIfMissing="true" />
    <CheckBox android:id="@id/download_checked" android:layout_width="16dp" android:layout_height="wrap_content"
        android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:layout_marginStart="16dp" android:layout_marginEnd="4dp"
        android:focusable="false" android:clickable="false" android:minHeight="0dp" android:minWidth="0dp" android:padding="0dp"
        android:button="@drawable/dialog_checkbox" android:buttonTint="@null" />
</RelativeLayout>
