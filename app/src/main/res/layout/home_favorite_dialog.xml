<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingTop="12dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/home_favorite_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ref_favorite_edit"
        android:textDirection="locale"
        style="@style/Widget.PureBrowser.FavoriteDialogCaption"/>
    <ImageView
        android:id="@+id/home_favorite_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="0dp"
        android:layout_below="@+id/home_favorite_caption"
        android:layout_alignTop="@+id/home_favorite_title_scroll"
        android:contentDescription="@string/ref_favorite_icon_label"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="0dp"/>
    <ImageView
        android:id="@+id/home_favorite_remove"
        android:padding="5dp"
        android:visibility="gone"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginTop="-8dp"
        android:layout_marginRight="-8dp"
        android:src="@drawable/ref_home_remove"
        android:tint="#55ffffff"
        android:layout_alignTop="@+id/home_favorite_icon"
        android:layout_alignRight="@+id/home_favorite_icon"
        android:contentDescription="@string/ref_favorite_remove"
        android:alpha="0.8"
        android:layout_marginEnd="-8dp"
        android:layout_alignEnd="@+id/home_favorite_icon"/>
    <HorizontalScrollView
        android:id="@+id/home_favorite_title_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:fillViewport="true"
        android:layout_toRightOf="@+id/home_favorite_icon"
        android:layout_below="@+id/home_favorite_caption"
        android:layout_toEndOf="@+id/home_favorite_icon"
        style="@style/Widget.PureBrowser.FavoriteDialogFieldScroll">
        <EditText
            android:id="@+id/home_favorite_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/ref_bookmark_form_title_hint"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionNext"
            android:textDirection="locale"
            style="@style/Widget.PureBrowser.FavoriteDialogField"/>
    </HorizontalScrollView>
    <HorizontalScrollView
        android:id="@+id/home_favorite_url_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:fillViewport="true"
        android:layout_toRightOf="@+id/home_favorite_icon"
        android:layout_below="@+id/home_favorite_title_scroll"
        android:layout_toEndOf="@+id/home_favorite_icon"
        style="@style/Widget.PureBrowser.FavoriteDialogFieldScroll">
        <EditText
            android:id="@+id/home_favorite_url"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:hint="@string/ref_bookmark_form_url_hint"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionDone"
            style="@style/Widget.PureBrowser.FavoriteDialogField"/>
    </HorizontalScrollView>
    <TextView
        android:id="@+id/home_favorite_positive"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@android:string/ok"
        android:layout_below="@+id/home_favorite_url_scroll"
        android:layout_alignParentRight="true"
        android:layout_alignParentEnd="true"
        style="@style/Widget.PureBrowser.FavoriteDialogAction"/>
    <TextView
        android:id="@+id/home_favorite_negative"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@android:string/cancel"
        android:layout_toLeftOf="@+id/home_favorite_positive"
        android:layout_below="@+id/home_favorite_url_scroll"
        android:layout_toStartOf="@+id/home_favorite_positive"
        style="@style/Widget.PureBrowser.FavoriteDialogAction"/>
</RelativeLayout>
