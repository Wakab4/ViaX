<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp">
    <TextView android:id="@+id/web_download_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="6dp"
        android:paddingTop="8dp" android:paddingBottom="8dp" android:textSize="16sp" android:textStyle="bold"
        android:lines="1" android:maxLines="2" android:ellipsize="end" android:text="你想要下载此文件吗？" android:textDirection="locale" />
    <HorizontalScrollView android:id="@+id/web_download_name_scroll" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_below="@id/web_download_title" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="12dp"
        android:fillViewport="true" android:paddingTop="8dp" android:paddingBottom="8dp" android:scrollbars="none" android:background="@drawable/dialog_field_underline">
        <EditText android:id="@+id/web_download_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@android:color/transparent" android:textSize="14sp" android:lines="1" android:maxLines="1"
            android:hint="文件名" android:inputType="textNoSuggestions" android:imeOptions="actionDone" android:textDirection="locale" />
    </HorizontalScrollView>
    <TextView android:id="@+id/web_download_size" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_below="@id/web_download_name_scroll" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="12dp"
        android:textSize="12sp" android:minLines="1" android:ellipsize="end" android:textDirection="locale" />
    <TextView android:id="@+id/web_download_accept" style="@style/Widget.ViaBrowser.DialogButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_below="@id/web_download_size" android:layout_alignParentEnd="true" android:text="@android:string/ok" />
    <TextView android:id="@+id/web_download_copy" style="@style/Widget.ViaBrowser.DialogButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_alignTop="@id/web_download_accept" android:layout_alignParentStart="true" android:text="复制链接" />
    <TextView android:id="@+id/web_download_cancel" style="@style/Widget.ViaBrowser.DialogButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_alignTop="@id/web_download_accept" android:layout_toStartOf="@id/web_download_accept" android:text="@android:string/cancel" />
</RelativeLayout>
