<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/home_design_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="48dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/home_design_hint"
        android:background="#ff333333"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <TextView
            android:textColor="#B2FFFFFF"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/ref_home_design_homepage_hint"
            android:layout_weight="1"/>
        <TextView
            android:textColor="@color/ref_home_design_accent"
            android:gravity="center"
            android:id="@+id/home_design_set_home"
            android:background="@drawable/dialog_button_feedback"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="56dp"
            android:text="@android:string/ok"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/home_design_tools"
        android:background="#B2FFFFFF"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="136dp"
        android:layout_above="@+id/home_design_tabs"
        android:translationY="160dp"/>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/home_design_tabs"
        android:background="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <RadioButton
            android:id="@+id/home_design_logo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/ref_home_design_logo"
            android:layout_weight="1"
            style="@style/Widget.ViaBrowser.HomeDesignTab"/>
        <RadioButton
            android:id="@+id/home_design_search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/ref_home_design_search"
            android:layout_weight="1"
            style="@style/Widget.ViaBrowser.HomeDesignTab"/>
        <RadioButton
            android:id="@+id/home_design_background"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/ref_home_design_background"
            android:layout_weight="1"
            style="@style/Widget.ViaBrowser.HomeDesignTab"/>
        <RadioButton
            android:id="@+id/home_design_favorites"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/ref_home_design_favorites"
            android:layout_weight="1"
            style="@style/Widget.ViaBrowser.HomeDesignTab"/>
        <RadioButton
            android:id="@+id/home_design_advanced"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/ref_home_design_advanced"
            android:layout_weight="1"
            style="@style/Widget.ViaBrowser.HomeDesignTab"/>
    </RadioGroup>
</RelativeLayout>
